  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 20000
    },
    "buffer": "30%"
  },
  // In V2, use permissions, shell, and subagent instead of permission, bash, and task.
  "agent": {
    "reviewer": {  // Specialized review subagent. Choose a different model than build, just to have a "second pair of eyes"
      "description": "Reviews current changes for best practices and potential issues",
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash-free",
      "system": "You are a professional reviewer. Focus on security, performance, and maintainability. Report findings in severity order.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git push *", "effect": "deny" }
      ]
    }
  }
