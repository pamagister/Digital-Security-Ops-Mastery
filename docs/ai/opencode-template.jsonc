  // Default model for new sessions. Select a paid or free model as appropriate.
  "model": "openrouter/baidu/ernie-5.5-flash-preview:free",

  "compaction": {
    "auto": true,
    "keep": { "tokens": 12000 },
    "buffer": "30%"
  },

  "agents": {
    // Built-in plan agent: allow plan-file edits in the active project.
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "**/*plan*.md", "effect": "allow" }
      ]
    },

    // Read-only exploration: use a free model and return a concise file/symbol map.
    "explore": {
      "description": "Read-only code exploration with a concise file and symbol map",
      "mode": "subagent",
      "model": "kilo/nvidia/nemotron-3.5-super-vl:free",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    // General-purpose research subagent.
    "general": {
      "description": "Research and multi-step work with broad tool access",
      "mode": "subagent",
      "model": "kilo/nvidia/nemotron-3.5-super-vl:free"
    },

    // Context maintenance uses a lightweight model.
    "compaction": {
      "model": "kilo/nvidia/nemotron-3.5-super-vl:free"
    },

    // Session titles are cosmetic and can use a free model.
    "title": {
      "model": "kilo/nvidia/nemotron-3.5-super-vl:free"
    }
  },

  "permissions": [
    // Require approval before accessing files outside the active project.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Protect system and user configuration.
    { "action": "edit", "resource": "/etc/**", "effect": "deny" },
    { "action": "edit", "resource": "/usr/**", "effect": "deny" },
    { "action": "edit", "resource": "/boot/**", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/.config/**", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/.local/**", "effect": "deny" },

    // Protect personal documents and credentials.
    { "action": "edit", "resource": "$HOME/Documents/**", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/Pictures/**", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/Videos/**", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/Music/**", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/.ssh/**", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/.gnupg/**", "effect": "deny" },
    { "action": "read", "resource": "$HOME/.ssh/**", "effect": "ask" },
    { "action": "read", "resource": "$HOME/.gnupg/**", "effect": "ask" },
    { "action": "read", "resource": "$HOME/.password-store/**", "effect": "ask" },

    // Dangerous shell commands.
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -r *", "effect": "deny" },
    { "action": "shell", "resource": "shred *", "effect": "deny" },
    { "action": "shell", "resource": "wipefs *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "dd *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "pkexec *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl *", "effect": "ask" },
    { "action": "shell", "resource": "apt *", "effect": "ask" },
    { "action": "shell", "resource": "apt-get *", "effect": "ask" },
    { "action": "shell", "resource": "dpkg *", "effect": "ask" },
    { "action": "shell", "resource": "chmod -R *", "effect": "ask" },
    { "action": "shell", "resource": "chown -R *", "effect": "ask" },

    // Git safety.
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "allow" }
  ]
}